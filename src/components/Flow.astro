---
// Flow diagram: wide SVG when the container is wide enough, a stacked list otherwise.
// Packets move along edges only while the figure is on screen and not paused.
import { layout, type FlowSpec } from '../lib/flow';
interface Props {
  spec: FlowSpec; label: string; alt: string; id: string;
  controls?: boolean; notes?: { name: string; note: string }[]; compact?: boolean; fill?: boolean;
}
const { spec, label, alt, id, controls = false, notes, compact = false, fill = false } = Astro.props;
const g = layout(spec);
const vwNum = g.w;
const stageOf = (s: number) => g.nodes.filter((n) => n.stage === s);
---
<figure class:list={['flow', compact && 'flow-compact', fill && 'flow-fill']} data-flow data-w={g.w} style={`--vw:${g.w}px`}>
  {!compact && (
    <div class="flow-head">
      <p class="label flow-label">{label}</p>
      {controls && <button class="ctl flow-ctl" type="button" aria-pressed="false" data-flow-ctl>Pause flow</button>}
    </div>
  )}
  <div class="flow-box">
    <svg class="flow-wide" viewBox={`0 0 ${g.w} ${g.h}`} width={g.w} height={g.h} role="group" aria-label={`${label}. ${alt}`}>
      <defs>
        <marker id={`ar-${id}`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L8 4L0 8z" class="fl-arrow" /></marker>
      </defs>
      {g.edges.map((e) => <path d={e.d} class="fl-edge" marker-end={`url(#ar-${id})`} />)}
      {g.edges.map((e) => <circle r="3.2" class="fl-pkt" style={`offset-path:path('${e.d}');animation-delay:${(e.stage * 0.9).toFixed(1)}s`} />)}
      {g.nodes.map((n) => (
        <g class:list={['fl-node', n.plain && 'plain']} data-stage={n.stage} tabindex={notes ? 0 : undefined} role={notes ? 'button' : undefined} aria-label={notes ? `${n.lines.join(' ')}: ${notes[n.stage]?.note}` : undefined}
           style={`animation-delay:${(n.stage * 0.9).toFixed(1)}s`}>
          <rect x={n.x} y={n.y} width={n.w} height={n.h} rx={n.plain ? 4 : 8} />
          {n.plain && <circle cx={n.x + 9} cy={n.y + n.h / 2} r="2.5" class="fl-dot" />}
          {n.lines.map((l, i) => (
            <text x={n.plain ? n.x + 22 : n.x + n.w / 2} y={n.y + n.h / 2 + (i - (n.lines.length - 1) / 2) * 18 + 5} text-anchor={n.plain ? 'start' : 'middle'}>{l}</text>
          ))}
        </g>
      ))}
    </svg>
    <ol class="flow-stack" aria-hidden="true">
      {spec.stages.map((s, i) => (
        <li class:list={[s.plain && 'plain']}>
          {stageOf(i).map((n) => <span class="fs-node">{n.lines.join(' ')}</span>)}
        </li>
      ))}
    </ol>
  </div>
  {compact && <p class="label flow-label flow-cap">{label}</p>}
  {notes && <p class="flow-note" data-note-bar aria-live="polite">Hover or focus a stage to read its design note.</p>}
  <div class="flow-foot">
    <p class="flow-alt"><span class="vh">Text alternative: </span>{alt}</p>
  </div>
  {notes && (
    <ul class="flow-notes">
      {notes.map((n) => <li><strong>{n.name}</strong>: {n.note}</li>)}
    </ul>
  )}
</figure>

<script>import '../scripts/flow';</script>
